# Set in the backend process environment / Render. Never copy to NEXT_PUBLIC_*.
# For local development use an isolated project or local Supabase, not production.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=v1
# Optional JSON mapping of previous versions to Fernet keys for rotation.
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS={}
CORS_ORIGINS=http://localhost:3000
# Enable for public hosting (also defaults on when RENDER=true).
ETL_PUBLIC_EGRESS_ONLY=true
# Optional comma-separated DNS host allowlist, in addition to public-IP validation.
ETL_DIRECT_HOST_ALLOWLIST=
ETL_SAVED_CONNECTIONS_ENABLED=true
ETL_MONITORING_ENABLED=true
ETL_SOURCE_CONNECT_TIMEOUT=10
